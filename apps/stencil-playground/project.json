{
  "name": "stencil-playground",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "apps/stencil-playground/src",
  "tags": ["type:stencil", "scope:playground"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm stencil build",
        "cwd": "apps/stencil-playground"
      },
      "outputs": ["{projectRoot}/dist", "{projectRoot}/loader", "{projectRoot}/hydrate", "{projectRoot}/src/react"],
      "dependsOn": ["^build"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "pnpm dev",
        "cwd": "apps/stencil-playground"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm oxlint src/",
        "cwd": "apps/stencil-playground"
      }
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm oxfmt src/",
        "cwd": "apps/stencil-playground"
      }
    },
    "fmt:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm oxfmt --check src/",
        "cwd": "apps/stencil-playground"
      }
    }
  }
}
