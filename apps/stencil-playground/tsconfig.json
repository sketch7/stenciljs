{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "experimentalDecorators": true,
    "lib": ["dom", "ES2024"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "ES2024",
    "customConditions": ["@ssv/source"],
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "h.Fragment",
    "paths": {
      "#/api": ["./src/examples/lol-draft-lobby-simulator/shared/lol.types.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "loader", "hydrate", "www", "src/react"]
}
