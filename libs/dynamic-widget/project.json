{
  "name": "dynamic-widget",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/dynamic-widget/src",
  "tags": ["type:stencil", "scope:widgets"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm stencil build",
        "cwd": "libs/dynamic-widget"
      },
      "outputs": ["{projectRoot}/dist", "{projectRoot}/loader", "{projectRoot}/hydrate"],
      "dependsOn": ["^build"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "pnpm stencil build --dev --watch",
        "cwd": "libs/dynamic-widget"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm oxlint src/",
        "cwd": "libs/dynamic-widget"
      }
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm oxfmt src/",
        "cwd": "libs/dynamic-widget"
      }
    },
    "fmt:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm oxfmt --check src/",
        "cwd": "libs/dynamic-widget"
      }
    }
  }
}
