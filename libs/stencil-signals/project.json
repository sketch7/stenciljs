{
  "name": "stencil-signals",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/stencil-signals/src",
  "tags": ["type:lib", "scope:signals"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm build",
        "cwd": "libs/stencil-signals"
      },
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm test",
        "cwd": "libs/stencil-signals"
      },
      "cache": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm oxlint src/ tests/",
        "cwd": "libs/stencil-signals"
      },
      "dependsOn": []
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm oxfmt src/ tests/",
        "cwd": "libs/stencil-signals"
      }
    },
    "fmt:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm oxfmt --check src/ tests/",
        "cwd": "libs/stencil-signals"
      }
    }
  }
}
