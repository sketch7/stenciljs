{
  "name": "@ssv/stencil-ui",
  "version": "0.0.0-PLACEHOLDER",
  "description": "Stencil UI primitives — ssv-compose registry-driven composition",
  "license": "MIT",
  "files": [
    "dist",
    "loader",
    "hydrate"
  ],
  "type": "module",
  "types": "dist/compose.d.ts",
  "exports": {
    ".": {
      "@ssv/source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compose": {
      "@ssv/source": "./src/compose/index.ts",
      "types": "./dist/compose.d.ts",
      "import": "./dist/compose.js"
    },
    "./loader": {
      "import": "./loader/index.js"
    },
    "./hydrate": {
      "types": "./hydrate/index.d.ts",
      "import": "./hydrate/index.mjs",
      "require": "./hydrate/index.js",
      "default": "./hydrate/index.js"
    },
    "./dist/components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./dist/components/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./dist/components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    }
  },
  "scripts": {
    "build": "stencil build && tsdown",
    "dev": "stencil build --dev --watch",
    "lint": "oxlint src/",
    "fmt": "oxfmt src/",
    "fmt:check": "oxfmt --check src/"
  },
  "dependencies": {
    "@ssv/stencil.core": "workspace:*",
    "@stencil/core": "catalog:"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@stencil/core": ">=4.0.0"
  },
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "packageManager": "pnpm@9.15.0"
}
