{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "lib": ["dom", "ES2024"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "ES2024",
    "customConditions": ["@ssv/source"],
    "resolveJsonModule": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "h.Fragment"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "loader", "hydrate", "www"]
}
