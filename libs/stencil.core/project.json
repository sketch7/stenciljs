{
  "name": "stencil-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/stencil.core/src",
  "tags": ["type:lib", "scope:core"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm build",
        "cwd": "libs/stencil.core"
      },
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "build:stencil": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm build:stencil",
        "cwd": "libs/stencil.core"
      },
      "outputs": ["{projectRoot}/dist/components"],
      "cache": true,
      "dependsOn": []
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm test",
        "cwd": "libs/stencil.core"
      },
      "cache": true,
      "dependsOn": ["build:stencil"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm oxlint src/ tests/",
        "cwd": "libs/stencil.core"
      }
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm oxfmt src/ tests/",
        "cwd": "libs/stencil.core"
      }
    },
    "fmt:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm oxfmt --check src/",
        "cwd": "libs/stencil.core"
      }
    }
  }
}
