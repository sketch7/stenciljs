{
  "name": "@ssv/tanstack.stencil-query",
  "version": "0.0.0-PLACEHOLDER",
  "description": "TanStack Query bindings for StencilJS — reactive server-state management with SSR hydration support.",
  "license": "MIT",
  "author": {
    "name": "sketch7",
    "url": "https://github.com/sketch7"
  },
  "contributors": [
    "Stephen Lautier (https://github.com/stephenlautier)",
    "Kurt Aquilina (https://github.com/kurtaqui)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sketch7/stenciljs.git",
    "directory": "libs/tanstack.stencil-query"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@ssv/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./signals": {
      "@ssv/source": "./src/signals/index.ts",
      "types": "./dist/signals/index.d.ts",
      "import": "./dist/signals/index.js"
    },
    "./dev-tools": {
      "@ssv/source": "./src/dev-tools/index.ts",
      "types": "./dist/dev-tools/index.d.ts",
      "import": "./dist/dev-tools/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src/",
    "fmt": "oxfmt src/",
    "fmt:check": "oxfmt --check src/"
  },
  "dependencies": {
    "@tanstack/query-devtools": "catalog:"
  },
  "devDependencies": {
    "@ssv/stencil-core": "workspace:*",
    "@ssv/stencil-signals": "workspace:*",
    "@stencil/core": "catalog:",
    "@tanstack/query-core": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@ssv/stencil-core": "workspace:*",
    "@ssv/stencil-signals": "workspace:*",
    "@stencil/core": ">=4.0.0",
    "@tanstack/query-core": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@ssv/stencil-signals": {
      "optional": true
    }
  }
}
