{
  "name": "@ssv/stenciljs",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=9.0.0",
    "npm": ">=10.0.0"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test --if-present",
    "lint": "nx run-many -t lint",
    "fmt": "nx run-many -t fmt",
    "fmt:check": "nx run-many -t fmt:check",
    "nx:reset": "nx reset",
    "dev:playground": "nx run stencil-playground:build && nx run-many -p stencil-playground,vike-playground -t dev --parallel",
    "kill-ports": "bash scripts/kill-ports.sh",
    "__CI__": "",
    "pre-release-build": "nx release version $VERSION",
    "release": "nx release publish"
  },
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "@nx/js": "22.7.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "nx": "22.7.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tslib": "^2.3.0",
    "typescript": "catalog:"
  }
}
